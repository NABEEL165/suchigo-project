{% extends 'waste_collector_dashboard.html' %}

{% block title %}Suchigo{% endblock %}

{% block content %}
    <title>Assigned Collections - SuchiGo</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #e8f8f2 0%, #e0f4f1 50%, #e8f8f2 100%);
            color: #333;
            min-height: 100vh;
        }

        .container {
            max-width: 1500px;
            margin: 0 auto;
            margin-top: 100px;
            background: linear-gradient(135deg, #ffffff 0%, #f8fffe 100%);
            border-radius: 15px;
            box-shadow: 0 8px 32px rgba(46, 139, 87, 0.15);
            overflow: hidden;
            border: 1px solid #2e8b57;
        }

        .header {
            background: linear-gradient(135deg, #2e8b57 0%, #1c6d42 100%);
            color: #ffffff;
            padding: 25px;
            text-align: center;
            position: relative;
            border-bottom: 2px solid #4ade80;
        }

        .brand-title {
            font-size: 2rem;
            margin-bottom: 5px;
            font-weight: 700;
            letter-spacing: -0.5px;
        }

        .brand-tagline {
            font-size: 1rem;
            opacity: 0.8;
            font-weight: 400;
            margin-bottom: 15px;
        }

        .header-buttons {
            margin-top: 15px;
        }

        h2 {
            font-size: 1.6rem;
            opacity: 0.9;
            font-weight: 600;
            display: none;
        }

        .page-title {
            font-size: 1.6rem;
            opacity: 0.9;
            font-weight: 600;
            color: #fff;
        }

        .content {
            padding: 30px;
        }

        /* Statistics Cards */
        .stats-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: #3a3a3a; /* Dark gray card */
            border-radius: 10px;
            padding: 20px;
            text-align: center;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
            border-left: 5px solid #666;
            transition: all 0.3s ease;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.4);
            background: #444;
        }

        .stat-number {
            font-size: 2rem;
            font-weight: 700;
            color: #fff; /* White text */
            margin-bottom: 5px;
        }

        .stat-label {
            font-size: 0.9rem;
            color: #666; /* Dark gray text */
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* Table Container */
        .table-container {
            background: #ffffff; /* White background */
            border-radius: 15px;
            box-shadow: 0 8px 25px rgba(46, 139, 87, 0.15);
            border: 1px solid #2e8b57;
            overflow: hidden;
            margin-bottom: 30px;
            position: relative;
        }

        .table-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #4ade80, #22d3ee);
        }

        .table-header {
            background: linear-gradient(135deg, #2e8b57 0%, #1c6d42 100%);
            padding: 20px 25px;
            border-bottom: 2px solid #4ade80;
        }

        .table-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: #fff; /* White text */
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .table-title::before {
            content: '📋';
            font-size: 1.3em;
        }

        .table-wrapper {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin: 0;
            background: #ffffff; /* White background */
            min-width: 1200px;
            border: 1px solid #e0e0e0;
        }

        table thead tr {
            background: linear-gradient(135deg, #2e8b57 0%, #1c6d42 100%);
        }

        table th {
            color: #fff;
            font-weight: 600;
            padding: 18px 15px;
            text-align: left;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            position: sticky;
            top: 0;
            z-index: 10;
            border-right: 1px solid #4ade80;
        }

        /* Add emoji icons to headers */
        table th:nth-child(1)::before { content: '👤 '; }
        table th:nth-child(2)::before { content: '📞 '; }
        table th:nth-child(3)::before { content: '📱 '; }
        table th:nth-child(4)::before { content: '🏠 '; }
        table th:nth-child(5)::before { content: '📍 '; }
        table th:nth-child(6)::before { content: '🌍 '; }
        table th:nth-child(7)::before { content: '🏙️ '; }
        table th:nth-child(8)::before { content: '🏛️ '; }
        table th:nth-child(9)::before { content: '📅 '; }
        table th:nth-child(10)::before { content: '🏘️ '; }
        table th:nth-child(11)::before { content: '🛍️ '; }
        table th:nth-child(12)::before { content: '🗑️ '; }
        table th:nth-child(13)::before { content: '🔢 '; }
        table th:nth-child(14)::before { content: '🗺️ '; }
        table th:nth-child(15)::before { content: '✅ '; }

        table td {
            padding: 18px 15px;
            border-bottom: 1px solid #e0e0e0;
            color: #333; /* Dark text */
            vertical-align: middle;
            font-size: 0.95rem;
            border-right: 1px solid #e0e0e0;
        }

        table tbody tr {
            transition: all 0.3s ease;
            background: #ffffff; /* White background */
        }

        table tbody tr:hover {
            background: #f8f9fa; /* Light hover */
            transform: scale(1.005);
            box-shadow: 0 2px 8px rgba(33, 150, 243, 0.1);
        }

        table tbody tr:nth-child(even) {
            background: #f0f0f0; /* Slightly darker */
        }

        table tbody tr:nth-child(even):hover {
            background: #f8f9fa; /* Consistent hover */
        }

        /* Customer name styling */
        td:first-child {
            font-weight: 600;
            color: #000000;
            background: linear-gradient(135deg, rgba(74, 222, 128, 0.1) 0%, rgba(34, 211, 238, 0.1) 100%);
            padding: 12px 15px;
            border-radius: 6px;
        }

        /* Bags styling */
        td:nth-child(11) {
            font-weight: 600;
            color: #4dabf7; /* Light blue */
            text-align: center;
        }

        /* Waste type styling */
        td:nth-child(12) {
            font-weight: 600;
            color: #ffd43b; /* Yellow */
            text-align: center;
        }

        /* Form and button styling */
        form {
            margin: 0;
            display: flex;
            justify-content: center;
        }

        input[type="hidden"] {
            display: none;
        }

        button[type="submit"] {
            background: linear-gradient(135deg, #4ade80 0%, #22d3ee 100%);
            color: #fff;
            padding: 12px 24px;
            border: 1px solid #4ade80;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(74, 222, 128, 0.3);
            min-width: 100px;
        }

        button[type="submit"]:hover {
            background: linear-gradient(135deg, #2e8b57 0%, #0891b2 100%);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(46, 139, 87, 0.4);
        }

        button[type="submit"]:active {
            transform: translateY(1px);
        }

        .btn-secondary {
            background: linear-gradient(135deg, #4ade80 0%, #22d3ee 100%);
            color: #fff;
            padding: 12px 25px;
            border: 1px solid #4ade80;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 150px;
            box-shadow: 0 4px 15px rgba(74, 222, 128, 0.3);
            margin-top: 20px;
        }

        .btn-secondary:hover {
            background: linear-gradient(135deg, #2e8b57 0%, #0891b2 100%);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(46, 139, 87, 0.4);
            text-decoration: none;
            color: white;
        }

        /* Empty state styling */
        td[colspan="15"] {
            text-align: center;
            padding: 60px 40px;
            color: #aaa; /* Gray text */
            font-style: italic;
            background: #333; /* Dark background */
            font-size: 1.2rem;
        }

        td[colspan="15"]::before {
            content: '📭';
            display: block;
            font-size: 4rem;
            margin-bottom: 20px;
            opacity: 0.7;
        }

        /* Priority indicators */
        .priority-high {
            position: relative;
        }

        .priority-high::after {
            content: '🔥';
            position: absolute;
            top: 5px;
            right: 5px;
            font-size: 0.8em;
        }

        /* Collection status indicators */
        .collection-ready {
            position: relative;
        }

        .collection-ready td:first-child::after {
            content: '🟢';
            margin-left: 8px;
            font-size: 0.8em;
        }

        /* Mobile responsiveness */
        @media (max-width: 768px) {
            .container {
                margin: 10px;
                border-radius: 15px;
            }

            .header {
                padding: 20px;
            }

            .brand-title {
                font-size: 1.8rem;
            }

            .page-title {
                font-size: 1.4rem;
            }

            .content {
                padding: 20px;
            }

            .table-header {
                padding: 20px;
            }

            .table-title {
                font-size: 1.4rem;
            }

            table {
                min-width: 1000px;
            }

            table th,
            table td {
                padding: 12px 8px;
                font-size: 0.85rem;
            }

            button[type="submit"] {
                padding: 10px 18px;
                font-size: 0.8rem;
                min-width: 80px;
            }

            .stats-container {
                grid-template-columns: repeat(2, 1fr);
                gap: 15px;
            }
        }

        /* Desktop navbar search fixes */
        @media (min-width: 992px) {
            /* Ensure navbar search is properly visible */
            .navbar-search {
                display: block !important;
                flex: 1;
                max-width: 400px;
                margin: 0 2rem;
            }

            .search-container {
                position: relative;
                width: 100%;
            }

            .search-input {
                background: rgba(255, 255, 255, 0.15);
                border: 2px solid rgba(255, 255, 255, 0.2);
                border-radius: 25px;
                color: white;
                padding: 0.6rem 1rem 0.6rem 2.5rem;
                width: 100%;
                transition: all 0.3s ease;
                font-size: 0.9rem;
            }

            .search-input::placeholder {
                color: rgba(255, 255, 255, 0.7);
            }

            .search-input:focus {
                background: rgba(255, 255, 255, 0.25);
                border-color: #4ade80;
                box-shadow: 0 0 0 0.2rem rgba(74, 222, 128, 0.25);
                outline: none;
            }

            .search-icon {
                position: absolute;
                left: 0.8rem;
                top: 50%;
                transform: translateY(-50%);
                color: rgba(255, 255, 255, 0.7);
                pointer-events: none;
            }
        }

        /* Additional responsive improvements */
        @media (max-width: 1200px) and (min-width: 992px) {
            .navbar-search {
                max-width: 300px;
                margin: 0 1rem;
            }
        }

        /* Loading states */
        .loading-row {
            opacity: 0.6;
            pointer-events: none;
        }

        .loading-spinner {
            display: inline-block;
            width: 16px;
            height: 16px;
            border: 2px solid rgba(33, 150, 243, 0.3);
            border-radius: 50%;
            border-top-color: #2196F3;
            animation: spin 1s ease-in-out infinite;
            margin-left: 8px;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        /* Animation classes */
        .fade-in {
            animation: fadeInUp 0.6s ease forwards;
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Success notification */
        .notification {
            position: fixed;
            top: 20px;
            right: 20px;
            background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);
            color: white;
            padding: 15px 25px;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(76, 175, 80, 0.3);
            z-index: 10000;
            transform: translateX(400px);
            transition: all 0.3s ease;
        }

        .notification.show {
            transform: translateX(0);
        }

        /* Local body section header */
        .localbody-header {
            background: linear-gradient(135deg, #2e8b57 0%, #1c6d42 100%);
            color: white;
            padding: 15px;
            border-radius: 8px;
            margin: 20px 0 10px 0;
            border: 1px solid #4ade80;
        }

        /* Page Search Box Styles */
        .page-search-container {
            background: linear-gradient(135deg, #2e8b57 0%, #1c6d42 100%);
            padding: 20px;
            border-radius: 12px;
            margin: 20px 0;
            border: 1px solid #4ade80;
            box-shadow: 0 4px 15px rgba(46, 139, 87, 0.2);
        }

        .filter-label {
            color: #fff;
            font-size: 1rem;
            font-weight: 600;
            margin-bottom: 15px;
            text-align: center;
        }

        .search-box {
            display: flex;
            gap: 10px;
            align-items: center;
            justify-content: center;
            margin-bottom: 15px;
        }

        #customerSearch {
            background: #444;
            color: #fff;
            border: 1px solid #666;
            padding: 12px 16px;
            border-radius: 6px;
            font-size: 1rem;
            width: 300px;
            transition: all 0.3s ease;
        }

        #customerSearch:focus {
            outline: none;
            border-color: #2196F3;
            box-shadow: 0 0 8px rgba(33, 150, 243, 0.3);
            background: #555;
        }

        #customerSearch::placeholder {
            color: #aaa;
        }

        .clear-btn {
            background: #666;
            color: #fff;
            border: 1px solid #777;
            padding: 12px;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .clear-btn:hover {
            background: #dc3545;
            border-color: #c82333;
        }

        .search-info {
            color: #aaa;
            font-size: 0.9rem;
            text-align: center;
            font-style: italic;
        }

        /* Hide filtered rows */
        .filtered-out {
            display: none;
        }

        /* No results message */
        .no-filter-results {
            text-align: center;
            padding: 40px;
            color: #aaa;
            font-size: 1.1rem;
            font-style: italic;
            background: #333;
            border-radius: 8px;
            margin: 20px 0;
            border: 1px solid #555;
        }

        .no-filter-results::before {
            content: '🔍';
            display: block;
            font-size: 2rem;
            margin-bottom: 15px;
            opacity: 0.7;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <div class="page-title">♻️ Assigned Waste Collection Details</div>
            <div class="header-buttons">
                <a href="{% url 'waste_collector:waste_collector_dashboard' %}" class="btn-secondary">
                    <i class="fas fa-arrow-left"></i> Back to Home
                </a>
            </div>
        </div>

        <div class="content">


            <!-- Table Container -->
            <div class="table-container">
                <div class="table-header">
                    <div class="table-title">Assigned Waste Collection Details</div>
                </div>

                <div class="table-wrapper">
                    <h2>Assigned Waste Collection Details</h2>

                    <!-- Customer Name Search -->
                    <div class="page-search-container">
                        <div class="filter-label">Search Customer Name:</div>
                        <div class="search-box">
                            <input type="text" id="customerSearch" placeholder="Type customer name to search..." autocomplete="off">
                            <button type="button" id="clearSearch" class="clear-btn">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                        <div class="search-info" id="searchInfo">Type to search customers instantly</div>
                    </div>

                    <!-- Share Options -->
                    <div style="margin: 15px 0; text-align: right;">
                        <button class="btn-secondary" onclick="sharePage()">
                            <i class="fas fa-share-alt"></i> Share
                        </button>
                        <button class="btn-secondary" onclick="showAbout()" style="margin-left: 10px;">
                            <i class="fas fa-info-circle"></i> About
                        </button>
                    </div>

                    <!-- Local Body Wise Grouping -->
                    {% if localbody_groups %}
                        {% for localbody_name, customers in localbody_groups.items %}
                            <div class="localbody-section">
                                <h3 class="localbody-header">
                                    🏛️ {{ localbody_name }} ({{ customers|length }} orders)
                                </h3>

                                <table border="1">
                                    <thead>
                                        <tr>
                                            <th>Customer Name</th>
                                            <th>Action</th>
                                            <th>Local Body</th>
                                            <th>District</th>
                                            <th>State</th>
                                            <th>Location</th>
                                            <th>Contact Number</th>
                                            <th>Secondary Number</th>
                                            <th>Pickup Address</th>
                                            <th>Pickup Date</th>
                                            <th>Ward</th>
                                            <th>Bags</th>
                                            <th>Waste Type</th>
                                            <th>Pincode</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for info in customers %}
                                            <tr class="fade-in collection-ready">
                                                <td>{{ info.user.get_full_name }}</td>
                                                <td>
                                                    <form action="{% url 'waste_collector:waste_collect_create' %}" method="get">
                                                        <input type="hidden" name="customer_waste_info_id" value="{{ info.id }}">
                                                        <input type="hidden" name="customer_id" value="{{ info.user.id }}">
                                                        {% if info.localbody %}<input type="hidden" name="localbody_id" value="{{ info.localbody.id }}">{% endif %}
                                                        {% if info.ward %}<input type="hidden" name="ward" value="{{ info.ward }}">{% endif %}
                                                        {% if info.pickup_address %}<input type="hidden" name="pickup_address" value="{{ info.pickup_address }}">{% endif %}
                                                        <button type="submit" >Accept</button>
                                                    </form>
                                                </td>
                                                <td>{{ info.localbody }}</td>
                                                <td>{{ info.district }}</td>
                                                <td>{{ info.state }}</td>
                                                <td>
                                                    {% if info.latitude and info.longitude %}
                                                        <a href="{{ info.get_google_maps_url }}" target="_blank" style="color: #2196F3; text-decoration: none;">📍 View Map</a>
                                                    {% else %}
                                                        Not Available
                                                    {% endif %}
                                                </td>
                                                <td>{{ info.user.contact_number }}</td>
                                                <td>{{ info.secondary_number }}</td>
                                                <td>{{ info.pickup_address }}</td>
                                                <td>
                                                    {% with pickup=info.customerpickupdate_set.first %}
                                                        {% if pickup %}
                                                            {{ pickup.localbody_calendar.date }}
                                                        {% else %}
                                                            Not Selected
                                                        {% endif %}
                                                    {% endwith %}
                                                </td>
                                                <td>{{ info.ward }}</td>
                                                <td>{{ info.number_of_bags}}</td>
                                                <td>{{ info.waste_type }}</td>
                                                <td>{{ info.pincode }}</td>
                                            </tr>
                                        {% empty %}
                                            <tr><td colspan="14">No assignments for this local body.</td></tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% endfor %}
                    {% else %}
                        <table border="1">
                            <thead>
                                <tr>
                                    <th>Customer Name</th>
                                    <th>Action</th>
                                    <th>Local Body</th>
                                    <th>District</th>
                                    <th>State</th>
                                    <th>Location</th>
                                    <th>Contact Number</th>
                                    <th>Secondary Number</th>
                                    <th>Pickup Address</th>
                                    <th>Pickup Date</th>
                                    <th>Ward</th>
                                    <th>Bags</th>
                                    <th>Waste Type</th>
                                    <th>Pincode</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for info in assigned_customers %}
                                    <tr class="fade-in collection-ready">
                                        <td>{{ info.user.get_full_name }}</td>
                                        <td>
                                            <form action="{% url 'waste_collector:waste_collect_create' %}" method="get">
                                                <input type="hidden" name="customer_waste_info_id" value="{{ info.id }}">
                                                <input type="hidden" name="customer_id" value="{{ info.user.id }}">
                                                {% if info.localbody %}<input type="hidden" name="localbody_id" value="{{ info.localbody.id }}">{% endif %}
                                                {% if info.ward %}<input type="hidden" name="ward" value="{{ info.ward }}">{% endif %}
                                                {% if info.pickup_address %}<input type="hidden" name="pickup_address" value="{{ info.pickup_address }}">{% endif %}
                                                <button type="submit" >Accept</button>
                                            </form>
                                        </td>
                                        <td>{{ info.localbody }}</td>
                                        <td>{{ info.district }}</td>
                                        <td>{{ info.state }}</td>
                                        <td>
                                            {% if info.latitude and info.longitude %}
                                                <a href="{{ info.get_google_maps_url }}" target="_blank" style="color: #2196F3; text-decoration: none;">📍 View Map</a>
                                            {% else %}
                                                Not Available
                                            {% endif %}
                                        </td>
                                        <td>{{ info.user.contact_number }}</td>
                                        <td>{{ info.secondary_number }}</td>
                                        <td>{{ info.pickup_address }}</td>
                                        <td>
                                            {% with pickup=info.customerpickupdate_set.first %}
                                                {% if pickup %}
                                                    {{ pickup.localbody_calendar.date }}
                                                {% else %}
                                                    Not Selected
                                                {% endif %}
                                            {% endwith %}
                                        </td>
                                        <td>{{ info.ward }}</td>
                                        <td>{{ info.number_of_bags}}</td>
                                        <td>{{ info.waste_type }}</td>
                                        <td>{{ info.pincode }}</td>
                                    </tr>
                                {% empty %}
                                    <tr><td colspan="14">No assignments yet. Check back later for new collection requests!</td></tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% endif %}
                </div>
            </div>
<!--            <a href="{% url 'waste_collector:waste_collector_dashboard' %}" class="btn-secondary">-->
<!--                ◀️ Back to Dashboard-->
            </div>
        </div>
    </div>

    <!-- Success Notification -->
    <div id="notification" class="notification">
        Assignment accepted successfully!
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Calculate and display statistics
            calculateStats();

            // Add staggered fade-in animation to table rows
            const tableRows = document.querySelectorAll('tbody tr.fade-in');
            tableRows.forEach((row, index) => {
                row.style.animationDelay = `${index * 0.1}s`;
            });

            // Add priority indicators to high-value collections
            addPriorityIndicators();

            // Initialize search filter
            initializeSearchFilter();
        });

        // Search Filter Functionality
        function initializeSearchFilter() {
            const searchInput = document.getElementById('customerSearch');
            const clearButton = document.getElementById('clearSearch');
            const searchInfo = document.getElementById('searchInfo');
            const tableRows = document.querySelectorAll('tbody tr.fade-in');
            
            // Real-time search as user types
            searchInput.addEventListener('input', function() {
                const searchTerm = this.value.trim().toLowerCase();
                filterTable(searchTerm, tableRows, searchInfo);
            });
            
            // Clear search
            clearButton.addEventListener('click', function() {
                searchInput.value = '';
                filterTable('', tableRows, searchInfo);
                searchInfo.textContent = 'Type to search customers instantly';
            });
            
            // Update search info as user types
            searchInput.addEventListener('input', function() {
                if (this.value.trim()) {
                    searchInfo.textContent = `Searching for "${this.value}"...`;
                } else {
                    searchInfo.textContent = 'Type to search customers instantly';
                }
            });
        }

        function filterTable(searchTerm, rows, searchInfo) {
            let visibleCount = 0;
            
            rows.forEach(row => {
                const customerNameCell = row.querySelector('td:first-child');
                const customerName = customerNameCell ? customerNameCell.textContent.trim().toLowerCase() : '';
                
                if (searchTerm === '') {
                    row.classList.remove('filtered-out');
                    visibleCount++;
                } else {
                    if (customerName.includes(searchTerm)) {
                        row.classList.remove('filtered-out');
                        visibleCount++;
                    } else {
                        row.classList.add('filtered-out');
                    }
                }
            });
            
            // Show/hide no results message
            showNoResultsMessage(visibleCount === 0, searchTerm);
        }

        function showNoResultsMessage(show, searchTerm = '') {
            // Remove existing no results message
            const existingMessage = document.querySelector('.no-filter-results');
            if (existingMessage) {
                existingMessage.remove();
            }
            
            if (show) {
                const tables = document.querySelectorAll('table');
                tables.forEach(table => {
                    const noResultsDiv = document.createElement('div');
                    noResultsDiv.className = 'no-filter-results';
                    noResultsDiv.innerHTML = `No customers found matching "${searchTerm}".`;
                    table.parentNode.insertBefore(noResultsDiv, table.nextSibling);
                });
            }
        }

        function calculateStats() {
            const rows = document.querySelectorAll('tbody tr:not([colspan])');
            let totalWeight = 0;
            let totalValue = 0;

            rows.forEach(row => {
                const cells = row.querySelectorAll('td');
                if (cells.length > 0) {
                    const kg = parseFloat(cells[6].textContent) || 0;
                    const amount = parseFloat(cells[7].textContent.replace('₹', '')) || 0;

                    totalWeight += kg;
                    totalValue += amount;
                }
            });

            // Calculate completion rate (simulate based on assignments)
            const completionRate = rows.length > 0 ? Math.floor(75 + Math.random() * 20) : 0;

            // Update stats with animation
            animateCounter('totalAssignments', rows.length);
            animateCounter('totalWeight', totalWeight, 'KG');
            animateCounter('totalValue', totalValue, '₹');
            animateCounter('completionRate', completionRate, '%');
        }

        function animateCounter(elementId, targetValue, suffix = '') {
            const element = document.getElementById(elementId);
            const startValue = 0;
            const duration = 2000;
            const startTime = performance.now();

            function updateCounter(currentTime) {
                const elapsedTime = currentTime - startTime;
                const progress = Math.min(elapsedTime / duration, 1);

                const easeOutCubic = 1 - Math.pow(1 - progress, 3);
                const currentValue = Math.floor(startValue + (targetValue - startValue) * easeOutCubic);

                element.textContent = suffix === '₹' ? `₹${currentValue}` :
                                    suffix === 'KG' ? `${currentValue} KG` :
                                    suffix === '%' ? `${currentValue}%` :
                                    currentValue;

                if (progress < 1) {
                    requestAnimationFrame(updateCounter);
                }
            }

            requestAnimationFrame(updateCounter);
        }

        function showLoading(button) {
            const originalText = button.textContent;
            button.innerHTML = 'Processing... <span class="loading-spinner"></span>';
            button.disabled = true;
            button.closest('tr').classList.add('loading-row');

            // Show success notification after a delay (simulating server response)
            setTimeout(() => {
                showNotification();
            }, 1500);
        }

        function showNotification() {
            const notification = document.getElementById('notification');
            notification.classList.add('show');

            setTimeout(() => {
                notification.classList.remove('show');
            }, 3000);
        }

        function addPriorityIndicators() {
            const rows = document.querySelectorAll('tbody tr:not([colspan])');

            rows.forEach(row => {
                const cells = row.querySelectorAll('td');
                if (cells.length > 0) {
                    const amount = parseFloat(cells[7].textContent.replace('₹', '')) || 0;

                    // Add priority indicator for high-value collections
                    if (amount > 500) {
                        row.classList.add('priority-high');
                    }
                }
            });
        }

        // Add hover effects to table rows
        document.querySelectorAll('tbody tr:not([colspan])').forEach(row => {
            row.addEventListener('mouseenter', function() {
                this.style.transform = 'scale(1.005)';
            });

            row.addEventListener('mouseleave', function() {
                this.style.transform = 'scale(1)';
            });
        });

        // Add ripple effect to buttons
        document.querySelectorAll('button[type="submit"]').forEach(button => {
            button.addEventListener('click', function(e) {
                const ripple = document.createElement('span');
                const rect = this.getBoundingClientRect();
                const size = Math.max(rect.width, rect.height);
                const x = e.clientX - rect.left - size / 2;
                const y = e.clientY - rect.top - size / 2;

                ripple.style.width = ripple.style.height = size + 'px';
                ripple.style.left = x + 'px';
                ripple.style.top = y + 'px';
                ripple.classList.add('ripple');

                this.appendChild(ripple);

                setTimeout(() => {
                    ripple.remove();
                }, 600);
            });
        });

        // Add ripple effect CSS
        const style = document.createElement('style');
        style.textContent = `
            button[type="submit"] {
                position: relative;
                overflow: hidden;
            }

            .ripple {
                position: absolute;
                border-radius: 50%;
                background: rgba(255, 255, 255, 0.6);
                transform: scale(0);
                animation: ripple-animation 0.6s linear;
                pointer-events: none;
            }

            @keyframes ripple-animation {
                to {
                    transform: scale(4);
                    opacity: 0;
                }
            }
        `;
        document.head.appendChild(style);

        // Share functionality
        function sharePage() {
            if (navigator.share) {
                navigator.share({
                    title: 'SuchiGo - Assigned Waste Collections',
                    text: 'Check out the assigned waste collection orders',
                    url: window.location.href
                }).catch(console.error);
            } else {
                // Fallback for browsers that don't support Web Share API
                alert('Sharing is not supported in your browser. Copy the URL: ' + window.location.href);
            }
        }

        // About functionality
        function showAbout() {
            alert('SuchiGo Waste Management System\n\nThis page shows all assigned waste collection orders grouped by local body for efficient pickup management.');
        }
    </script>
</body>

