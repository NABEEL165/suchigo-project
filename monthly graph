<!DOCTYPE html>
{% load static %}
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SuchiGo - Waste Collector Dashboard</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(135deg, #e8f8f2 0%, #e0f4f1 100%);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow-x: hidden;
        }

        /* Navbar Styles */
        .navbar {
            background: linear-gradient(135deg, #2e8b57 0%, #1c6d42 100%);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
            padding: 0.8rem 1rem;
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 1030;
        }

        .navbar-brand {
            color: white !important;
            font-weight: 700;
            font-size: 1.6rem;
            display: flex;
            align-items: center;
            gap: 0.8rem;
            text-decoration: none;
        }

        .logo-container {
            position: relative;
            width: 50px;
            height: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            overflow: hidden;
            background: white;
            padding: 2px;
        }

        .logo-image {
            width: 100%;
            height: 100%;
            object-fit: contain;
            border-radius: 10px;
        }

        .brand-text {
            display: flex;
            flex-direction: column;
            line-height: 1;
        }

        .brand-name {
            font-size: 1.8rem;
            font-weight: 800;
            background: linear-gradient(135deg, #4ade80 0%, #22d3ee 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: -2px;
        }

        .brand-tagline {
            font-size: 0.7rem;
            color: rgba(255, 255, 255, 0.8);
            font-weight: 400;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .navbar-search {
            flex: 1;
            max-width: 400px;
            margin: 0 2rem;
        }

        .search-container {
            position: relative;
        }

        .search-input {
            background: rgba(255, 255, 255, 0.15);
            border: 2px solid rgba(255, 255, 255, 0.2);
            border-radius: 25px;
            color: white;
            padding: 0.6rem 1rem 0.6rem 2.5rem;
            width: 100%;
            transition: all 0.3s ease;
        }

        .search-input::placeholder {
            color: rgba(255, 255, 255, 0.7);
        }

        .search-input:focus {
            background: rgba(255, 255, 255, 0.25);
            border-color: #4ade80;
            box-shadow: 0 0 0 0.2rem rgba(74, 222, 128, 0.25);
            outline: none;
        }

        .search-icon {
            position: absolute;
            left: 0.8rem;
            top: 50%;
            transform: translateY(-50%);
            color: rgba(255, 255, 255, 0.7);
        }

        .navbar-nav {
            display: flex;
            flex-direction: row;
            align-items: center;
            gap: 1rem;
        }

        .nav-item {
            position: relative;
        }

        .nav-icon-btn {
            background: rgba(255, 255, 255, 0.1);
            border: 2px solid rgba(255, 255, 255, 0.2);
            border-radius: 50%;
            color: white;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
            position: relative;
            cursor: pointer;
        }

        .nav-icon-btn:hover {
            background: rgba(255, 255, 255, 0.2);
            border-color: #4ade80;
            transform: translateY(-2px);
        }

        .notification-badge {
            position: absolute;
            top: -5px;
            right: -5px;
            background: #ef4444;
            color: white;
            border-radius: 50%;
            width: 18px;
            height: 18px;
            font-size: 0.7rem;
            display: flex;
            align-items: center;
            justify-content: center;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.1);
            }

            100% {
                transform: scale(1);
            }
        }

        .profile-dropdown {
            position: relative;
        }

        .profile-btn {
            background: rgba(255, 255, 255, 0.1);
            border: 2px solid rgba(255, 255, 255, 0.2);
            border-radius: 50%;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .profile-btn:hover {
            background: rgba(255, 255, 255, 0.2);
            border-color: #4ade80;
        }

        .dropdown-menu {
            background: white;
            border: none;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            margin-top: 0.5rem;
            min-width: 200px;
        }

        .dropdown-item {
            padding: 0.8rem 1.2rem;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 0.8rem;
        }

        .dropdown-item:hover {
            background: linear-gradient(135deg, #e8f8f2 0%, #e0f4f1 100%);
            color: #2e8b57;
        }

        /* Sidebar Styles */
        .sidebar {
            background: linear-gradient(180deg, #ffffff 0%, #f8fffe 100%);
            width: 280px;
            height: calc(100vh - 70px);
            position: fixed;
            top: 70px;
            left: 0;
            box-shadow: 4px 0 20px rgba(0, 0, 0, 0.1);
            z-index: 1025;
            transform: translateX(-100%);
            transition: transform 0.3s ease;
            overflow-y: auto;
        }

        .sidebar.active {
            transform: translateX(0);
        }

        .sidebar-header {
            padding: 1.5rem;
            border-bottom: 1px solid rgba(0, 0, 0, 0.1);
            background: linear-gradient(135deg, #2e8b57 0%, #22d3ee 100%);
            color: white;
            position: relative;
            overflow: hidden;
        }

        .sidebar-header::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20px;
            width: 100px;
            height: 200px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50px;
            transform: rotate(45deg);
        }

        .sidebar-title {
            font-size: 1.1rem;
            font-weight: 600;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .sidebar-menu {
            padding: 1rem 0;
        }

        .menu-section {
            margin-bottom: 1.5rem;
        }

        .menu-section-title {
            padding: 0.5rem 1.5rem;
            font-size: 0.8rem;
            font-weight: 600;
            color: #666;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 0.5rem;
        }

        .menu-item {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 0.8rem 1.5rem;
            color: #333;
            text-decoration: none;
            transition: all 0.3s ease;
            border-left: 4px solid transparent;
            position: relative;
        }

        .menu-item:hover,
        .menu-item.active {
            background: linear-gradient(135deg, #e8f8f2 0%, #e0f4f1 100%);
            color: #2e8b57;
            border-left-color: #4ade80;
            transform: translateX(5px);
        }

        .menu-item i {
            width: 20px;
            text-align: center;
            font-size: 1.1rem;
        }

        .menu-badge {
            background: linear-gradient(135deg, #4ade80 0%, #22d3ee 100%);
            color: white;
            border-radius: 12px;
            padding: 0.2rem 0.6rem;
            font-size: 0.7rem;
            margin-left: auto;
        }

        .logout-item {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            color: white !important;
            margin: 1rem;
            border-radius: 8px;
            border-left: none !important;
            text-align: center;
            font-weight: 600;
            position: absolute;
            bottom: 0;
            width: 86%;
        }

        .logout-item:hover {
            background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
            color: white !important;
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(239, 68, 68, 0.3);
        }

        .navbar-nav .dropdown-menu {
            position: absolute;
        }

        /* Main Content */
        .main-content {
            margin-left: 0;
            margin-top: 70px;
            padding: 2rem;
            transition: margin-left 0.3s ease;
            min-height: calc(100vh - 70px);
        }

        .main-content.sidebar-open {
            margin-left: 280px;
        }

        .sidebar-toggle {
            background: rgba(255, 255, 255, 0.1);
            border: 2px solid rgba(255, 255, 255, 0.2);
            color: white;
            border-radius: 8px;
            padding: 0.5rem 0.8rem;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-right: 1rem;
        }

        .sidebar-toggle:hover {
            background: rgba(255, 255, 255, 0.2);
            border-color: #4ade80;
        }

        /* Welcome Section */
        .welcome-section {
            background: linear-gradient(135deg, #ffffff 0%, #f8fffe 100%);
            border-radius: 20px;
            padding: 2rem;
            margin-bottom: 2rem;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
            position: relative;
            overflow: hidden;
        }

        .welcome-section::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 200px;
            height: 200px;
            background: linear-gradient(135deg, rgba(74, 222, 128, 0.1), rgba(34, 211, 238, 0.1));
            border-radius: 50%;
            transform: translate(50%, -50%);
        }

        .welcome-title {
            font-size: 2.2rem;
            font-weight: 700;
            color: #2e8b57;
            margin-bottom: 0.5rem;
            position: relative;
            z-index: 1;
        }

        .welcome-subtitle {
            font-size: 1.1rem;
            color: #666;
            margin-bottom: 0;
            position: relative;
            z-index: 1;
        }

        /* Statistics Cards */
        .stats-section {
            margin-bottom: 2rem;
        }

        .stat-card {
            background: white;
            border-radius: 15px;
            padding: 1.5rem;
            text-align: center;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            transition: all 0.3s ease;
            border-left: 5px solid;
            position: relative;
            overflow: hidden;
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, rgba(74, 222, 128, 0.1), rgba(34, 211, 238, 0.1));
            border-radius: 0 0 0 50px;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
        }

        .stat-card.total {
            border-left-color: #4ade80;
        }

        .stat-card.today {
            border-left-color: #22d3ee;
        }

        .stat-card.weight {
            border-left-color: #2e8b57;
        }

        .stat-card.revenue {
            border-left-color: #10b981;
        }

        .stat-icon {
            font-size: 2.5rem;
            margin-bottom: 1rem;
            background: linear-gradient(135deg, #4ade80 0%, #22d3ee 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .stat-number {
            font-size: 2rem;
            font-weight: bold;
            color: #2e8b57;
            margin-bottom: 0.5rem;
        }

        .stat-label {
            color: #666;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* Quick Actions */
        .quick-actions {
            margin-bottom: 2rem;
        }

        .section-title {
            font-size: 1.5rem;
            font-weight: 600;
            color: #2e8b57;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .action-card {
            background: white;
            border-radius: 15px;
            padding: 1.5rem;
            text-align: center;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            transition: all 0.3s ease;
            text-decoration: none;
            color: inherit;
            border-left: 5px solid;
            position: relative;
            overflow: hidden;
            display: block;
            height: 100%;
            cursor: pointer;
        }

        .action-card::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, rgba(74, 222, 128, 0.1), rgba(34, 211, 238, 0.1));
            border-radius: 0 0 0 50px;
        }

        .action-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
        }

        .action-card.add {
            border-left-color: #4ade80;
        }

        .action-card.view {
            border-left-color: #22d3ee;
        }

        .action-card.assigned {
            border-left-color: #2e8b57;
        }

        .action-card.orders {
            border-left-color: #10b981;
        }

        .action-card.reports {
            border-left-color: #f59e0b;
        }

        .action-card.analytics {
            border-left-color: #8b5cf6;
        }

        .action-icon {
            font-size: 2.5rem;
            margin-bottom: 1rem;
            background: linear-gradient(135deg, #4ade80 0%, #22d3ee 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .action-title {
            font-weight: 600;
            margin-bottom: 0.5rem;
            color: #2e8b57;
        }

        .action-description {
            font-size: 0.85rem;
            color: #666;
        }

        /* Table Container */
        .table-container {
            background: white;
            border-radius: 15px;
            padding: 1.5rem;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            position: relative;
            overflow: hidden;
        }

        .table-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #4ade80, #22d3ee);
        }

        .btn-success {
            background: linear-gradient(135deg, #4ade80 0%, #22d3ee 100%);
            border: none;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

        .btn-success:hover {
            background: linear-gradient(135deg, #2e8b57 0%, #0891b2 100%);
            transform: translateY(-1px);
        }

        .btn-outline-success {
            border-color: #4ade80;
            color: #4ade80;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

        .btn-outline-success:hover {
            background: linear-gradient(135deg, #4ade80 0%, #22d3ee 100%);
            border-color: #4ade80;
            color: white;
            transform: translateY(-1px);
        }

        /* Overlay */
        .sidebar-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 1020;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
        }

        .sidebar-overlay.active {
            opacity: 1;
            visibility: visible;
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            py: 5;
            background: white;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            position: relative;
            overflow: hidden;
        }

        .empty-state::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #4ade80, #22d3ee);
        }

        .empty-icon {
            background: linear-gradient(135deg, #4ade80 0%, #22d3ee 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        /* Analytics Section */
        .analytics-section {
            margin-bottom: 2rem;
        }

        .analytics-card {
            background: white;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            overflow: hidden;
            position: relative;
        }

        .analytics-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #4ade80, #22d3ee);
        }

        .card-header {
            background: linear-gradient(135deg, #f8fffe 0%, #ffffff 100%);
            padding: 1.2rem 1.5rem;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .card-title {
            font-size: 1.1rem;
            font-weight: 600;
            color: #2e8b57;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .card-controls {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .form-select-sm {
            font-size: 0.85rem;
            padding: 0.4rem 0.8rem;
            border-radius: 6px;
            border: 1px solid #e0e0e0;
            background: white;
        }

        .card-body {
            padding: 1.5rem;
        }

        .metric-card {
            background: white;
            border-radius: 15px;
            padding: 1.5rem;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            display: flex;
            align-items: center;
            gap: 1rem;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .metric-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
            background: linear-gradient(180deg, #4ade80, #22d3ee);
        }

        .metric-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
        }

        .metric-icon {
            width: 60px;
            height: 60px;
            border-radius: 12px;
            background: linear-gradient(135deg, #4ade80 0%, #22d3ee 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.5rem;
            flex-shrink: 0;
        }

        .metric-content {
            flex: 1;
        }

        .metric-value {
            font-size: 1.8rem;
            font-weight: 700;
            color: #2e8b57;
            margin-bottom: 0.3rem;
        }

        .metric-label {
            font-size: 0.9rem;
            color: #666;
            margin-bottom: 0.5rem;
        }

        .metric-change {
            font-size: 0.85rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 0.3rem;
        }

        .metric-change.positive {
            color: #10b981;
        }

        .metric-change.negative {
            color: #ef4444;
        }

        /* Mobile Responsive */
        @media (max-width: 992px) {
            .navbar-search {
                display: none;
            }

            .main-content.sidebar-open {
                margin-left: 0;
            }

            .main-content {
                padding: 1.5rem;
            }

            .brand-name {
                font-size: 1.4rem;
            }

            .brand-tagline {
                font-size: 0.6rem;
            }

            .welcome-title {
                font-size: 1.8rem;
            }

            .welcome-subtitle {
                font-size: 1rem;
            }

            .welcome-section {
                padding: 1.5rem;
            }
        }

        @media (max-width: 768px) {
            .navbar-nav {
                gap: 0.8rem;
            }

            .nav-icon-btn {
                width: 38px;
                height: 38px;
            }

            .main-content {
                padding: 1rem;
            }

            .stat-card {
                padding: 1.2rem;
                margin-bottom: 0.8rem;
            }

            .stat-number {
                font-size: 1.4rem;
            }

            .stat-icon {
                font-size: 2rem;
                margin-bottom: 0.5rem;
            }

            .action-card {
                padding: 1rem;
                margin-bottom: 0.8rem;
                min-height: 140px;
                display: flex;
                flex-direction: column;
                justify-content: center;
                align-items: center;
            }

            .action-icon {
                font-size: 1.8rem;
                margin-bottom: 0.6rem;
            }

            .action-title {
                font-size: 0.9rem;
                margin-bottom: 0.2rem;
            }

            .action-description {
                font-size: 0.75rem;
                display: none;
                /* Hide description on mobile to save space */
            }

            .logo-container {
                width: 40px;
                height: 40px;
            }

            .welcome-title {
                font-size: 1.5rem;
                text-align: center;
            }

            .welcome-subtitle {
                font-size: 0.9rem;
                text-align: center;
            }

            .welcome-section {
                padding: 1.5rem 1rem;
                text-align: center;
            }
        }

        @media (max-width: 576px) {
            .brand-text {
                display: none;
            }

            .welcome-title {
                font-size: 1.4rem;
            }

            .welcome-subtitle {
                font-size: 0.85rem;
            }

            .section-title {
                font-size: 1.1rem;
            }

            .main-content {
                padding: 0.8rem;
            }

            .welcome-section {
                margin-bottom: 1.5rem;
                border-radius: 15px;
            }

            .stats-section {
                margin-bottom: 1rem;
            }

            .quick-actions {
                margin-bottom: 1.5rem;
            }

            .table-container {
                padding: 1rem;
                border-radius: 12px;
            }

            .table th,
            .table td {
                font-size: 0.8rem;
                padding: 0.6rem 0.4rem;
            }

            .avatar-circle {
                width: 30px !important;
                height: 30px !important;
                font-size: 0.8rem !important;
            }
        }

        /* Support for very small devices */
        @media (max-width: 380px) {
            .stat-number {
                font-size: 1.2rem;
            }

            .stat-label {
                font-size: 0.7rem;
            }

            .action-title {
                font-size: 0.8rem;
            }
        }

        /* Impact Metric Box Styles */
        .impact-metric-box {
