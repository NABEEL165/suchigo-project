        });

        // Function to update charts based on selected local body
        function updateChartsByLocalBody(localBodyId) {
            let labels = window.originalImpactData.labels;
            let weights = window.originalImpactData.weights;
            let revenues = window.originalImpactData.revenues;
            
            // If a specific local body is selected, filter the data
            if (localBodyId !== 'all') {
                // Find the index of the selected local body in the original data
                const selectedIndex = window.originalImpactData.labels.indexOf(
                    document.querySelector(`#localBodyFilter option[value="${localBodyId}"]`).textContent
                );
                
                if (selectedIndex !== -1) {
                    // Only show data for the selected local body
                    labels = [window.originalImpactData.labels[selectedIndex]];
                    weights = [window.originalImpactData.weights[selectedIndex]];
                    revenues = [window.originalImpactData.revenues[selectedIndex]];
                } else {
                    // If local body not found in original data, clear the chart
                    labels = [];
                    weights = [];
                    revenues = [];
                }
            }
            
            // Update impact bar chart
            if (window.impactChart) {
                window.impactChart.data.labels = labels;
                window.impactChart.data.datasets[0].data = weights;
                window.impactChart.data.datasets[1].data = revenues;
                window.impactChart.update();
            }
            
            // Calculate and update summary stats based on filtered data
            const totalWeight = weights.reduce((sum, weight) => sum + weight, 0);
            const totalRevenue = revenues.reduce((sum, revenue) => sum + revenue, 0);
            const totalCollections = window.serverChartData.reduce((sum, item) => {
                if (localBodyId === 'all' || 
                    document.querySelector(`#localBodyFilter option[value="${localBodyId}"]`).textContent === item.localbody) {
                    return sum + item.count;
                }
                return sum;
            }, 0);
            
            // Update the summary cards
            document.getElementById('totalCollectionsImpact').textContent = totalCollections;
            document.getElementById('totalWeightImpact').textContent = totalWeight.toFixed(2) + ' KG';
            
            // Recalculate environmental impact based on filtered weight
            const co2Removed = (totalWeight * 0.92).toFixed(2);
            const treesEquivalent = Math.round(totalWeight * 0.08);
            
            document.getElementById('co2Saved').textContent = co2Removed + ' Tons';
            document.getElementById('treesEquivalent').textContent = treesEquivalent.toLocaleString();
        }

        // Period filter functionality
        document.getElementById('periodFilter')?.addEventListener('change', function(e) {
            const period = e.target.value;
            // Reload page with new period
            window.location.href = "{% url 'waste_collector:waste_collector_dashboard' %}?period=" + period;
        });

        // Function to update impact metrics
        function updateImpactMetrics() {
            // Get data from Django template or calculate from existing data
            const totalWeight = parseFloat("{{ total_weight|default:'0' }}") || 850;
            const todayWeight = parseFloat("{{ today_weight|default:'0' }}") || 45;
            const thisMonthWeight = parseFloat("{{ this_month_weight|default:'0' }}") || 320;
            const lastMonthWeight = parseFloat("{{ last_month_weight|default:'0' }}") || 285;
            
            // Calculate total waste in tons
            const totalWasteTons = (totalWeight / 1000).toFixed(1);
            
            // Calculate this month waste in tons
            const thisMonthWasteTons = (thisMonthWeight / 1000).toFixed(1);
            
            // Calculate today's collection in KG
            const todayCollectionKg = todayWeight.toFixed(1);
            
            // Calculate previous month comparison percentage
            let comparisonPercent = 0;
            if (lastMonthWeight > 0) {
                comparisonPercent = ((thisMonthWeight - lastMonthWeight) / lastMonthWeight * 100).toFixed(0);
            }
            
            // Update DOM elements
            const totalWasteElement = document.querySelector('.impact-metric-box .metric-value-small');
            const thisMonthElement = document.getElementById('thisMonthWaste');
            const todayElement = document.getElementById('todayWaste');
            const comparisonElement = document.getElementById('monthlyComparison');
            
            if (totalWasteElement) {
                totalWasteElement.textContent = totalWasteTons + ' T';
            }
            
            if (thisMonthElement) {
                thisMonthElement.textContent = thisMonthWasteTons + ' T';
            }
            
            if (todayElement) {
                todayElement.textContent = todayCollectionKg + ' KG';
            }
            
            if (comparisonElement) {
                const comparisonText = comparisonPercent >= 0 ? `+${comparisonPercent}%` : `${comparisonPercent}%`;
                comparisonElement.textContent = comparisonText;
                comparisonElement.className = comparisonPercent >= 0 ? 'metric-value-small text-success' : 'metric-value-small text-danger';
            }

            // Monthly Trend Chart
            const monthlyTrendCanvas = document.getElementById('monthlyTrendChart');
            if (monthlyTrendCanvas) {
                const ctx = monthlyTrendCanvas.getContext('2d');
                
                // Sample data for monthly trend
                const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'];
                const wasteData = [120, 145, 165, 178, 195, 210];
                const targetData = [140, 150, 160, 170, 180, 190];
                const efficiencyData = [85, 88, 92, 87, 94, 91];

                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: months,
                        datasets: [{
                            label: 'Waste Collected (Tons)',
                            data: wasteData,
                            borderColor: '#2e8b57',
                            backgroundColor: 'rgba(46, 139, 87, 0.1)',
                            borderWidth: 3,
                            fill: true,
                            tension: 0.4,
                            pointRadius: 5,
                            pointBackgroundColor: '#2e8b57',
                            pointBorderColor: '#ffffff',
                            pointBorderWidth: 2
                        }, {
                            label: 'Target (Tons)',
                            data: targetData,
                            borderColor: '#22d3ee',
                            backgroundColor: 'rgba(34, 211, 238, 0.1)',
                            borderWidth: 2,
                            borderDash: [5, 5],
                            fill: false,
                            tension: 0.4,
                            pointRadius: 4,
                            pointBackgroundColor: '#22d3ee',
                            pointBorderColor: '#ffffff',
                            pointBorderWidth: 2
                        }, {
                            label: 'Efficiency (%)',
                            data: efficiencyData,
                            borderColor: '#f59e0b',
                            backgroundColor: 'rgba(245, 158, 11, 0.1)',
                            borderWidth: 2,
                            fill: false,
                            tension: 0.4,
                            pointRadius: 4,
                            pointBackgroundColor: '#f59e0b',
                            pointBorderColor: '#ffffff',
                            pointBorderWidth: 2,
                            yAxisID: 'y1'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: {
                            mode: 'index',
                            intersect: false,
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                position: 'left',
                                title: {
                                    display: true,
                                    text: 'Tons'
                                },
                                grid: {
                                    color: 'rgba(0, 0, 0, 0.05)'
                                }
                            },
                            y1: {
                                beginAtZero: true,
                                position: 'right',
                                title: {
                                    display: true,
                                    text: 'Efficiency %'
                                },
                                grid: {
                                    drawOnChartArea: false
                                },
                                min: 0,
                                max: 100
                            },
                            x: {
                                grid: {
                                    display: false
                                }
                            }
                        },
                        plugins: {
                            legend: {
                                position: 'top',
                                labels: {
                                    usePointStyle: true,
                                    padding: 20
                                }
                            },
                            tooltip: {
                                backgroundColor: 'rgba(255, 255, 255, 0.95)',
                                titleColor: '#2e8b57',
                                bodyColor: '#333',
                                borderColor: 'rgba(46, 139, 87, 0.2)',
                                borderWidth: 1,
                                cornerRadius: 8,
                                padding: 12
                            }
                        }
                    }
                });
            }
        }

        // Initialize Impact Analytics Charts
        function initializeImpactCharts() {
            // Monthly Impact Chart
            const monthlyImpactCanvas = document.getElementById('monthlyImpactChart');
            if (monthlyImpactCanvas) {
                const ctx = monthlyImpactCanvas.getContext('2d');
                
                // Sample data for monthly impact
                const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'];
                const wasteData = [120, 145, 165, 178, 195, 210];
                const recyclingData = [45, 52, 58, 65, 72, 78];

                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: months,
                        datasets: [{
                            label: 'Waste Collected (Tons)',
                            data: wasteData,
                            backgroundColor: 'rgba(46, 139, 87, 0.8)',
                            borderColor: '#2e8b57',
                            borderWidth: 1,
                            borderRadius: 5,
                            yAxisID: 'y'
                        }, {
                            label: 'Recycled (Tons)',
                            data: recyclingData,
                            backgroundColor: 'rgba(34, 211, 238, 0.8)',
                            borderColor: '#22d3ee',
                            borderWidth: 1,
                            borderRadius: 5,
                            yAxisID: 'y'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: {
                            mode: 'index',
                            intersect: false,
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                title: {
                                    display: true,
                                    text: 'Tons'
                                },
                                grid: {
                                    color: 'rgba(0, 0, 0, 0.05)'
                                }
                            },
                            x: {
                                grid: {
                                    display: false
                                }
                            }
                        },
                        plugins: {
                            legend: {
                                position: 'top',
                                labels: {
                                    usePointStyle: true,
                                    padding: 20
                                }
                            }
                        }
                    }
                });
            }

            // Total Impact Gauge Chart
            const totalImpactCanvas = document.getElementById('totalImpactGauge');
            if (totalImpactCanvas) {
                const ctx = totalImpactCanvas.getContext('2d');
                
                new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        datasets: [{
                            data: [75, 25],
                            backgroundColor: [
                                'rgba(46, 139, 87, 0.8)',
                                'rgba(200, 200, 200, 0.2)'
                            ],
                            borderWidth: 0
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        circumference: 180,
                        rotation: 270,
                        cutout: '70%',
                        plugins: {
                            legend: {
                                display: false
                            },
                            tooltip: {
                                enabled: false
                            }
                        }
                    }
                });

                // Add center text
                const centerX = totalImpactCanvas.width / 2;
                const centerY = totalImpactCanvas.height / 2;
                ctx.font = 'bold 24px Arial';
                ctx.fillStyle = '#2e8b57';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillText('75%', centerX, centerY);
            }
        }

        // Initialize impact charts when DOM is loaded
        document.addEventListener('DOMContentLoaded', function() {
            initializeImpactCharts();
        });

        // Handle monthly impact filter
        document.getElementById('monthlyImpactFilter')?.addEventListener('change', function(e) {
            const months = parseInt(e.target.value);
            // Update chart data based on selected months
            console.log('Loading data for last', months, 'months');
            // Here you would typically make an API call to get updated data
            initializeImpactCharts(); // Reinitialize with new data
        });

        // Add keyboard shortcuts
        document.addEventListener('keydown', function (e) {
            // Ctrl/Cmd + K to focus search
            if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
                e.preventDefault();
                const searchInput = document.getElementById('globalSearch');
                if (searchInput) {
                    searchInput.focus();
                }
            }

            // Escape to close sidebar
            if (e.key === 'Escape') {
                closeSidebar();
            }
        });
    </script>

    <!-- Hidden script to pass chart data from Django template -->
    <script>
        window.serverChartData = [
            {% for data in chart_data %}
            {
                localbody: '{{ data.localbody|escapejs }}',
                weight: {{ data.weight }},
                revenue: {{ data.revenue }}
            }{% if not forloop.last %},{% endif %}
            {% endfor %}
        ];
    </script>
