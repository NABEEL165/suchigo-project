        function updateAnalyticsMetrics() {
            // Sample calculations - replace with actual data
            const totalCollections = parseInt("{{ total_collections|default:'0' }}") || 150;
            const totalWeight = parseFloat("{{ total_weight|default:'0' }}") || 850;
            const totalRevenue = parseFloat("{{ total_revenue|default:'0' }}") || 12500;

            // Calculate averages
            const avgDaily = (totalCollections / 30).toFixed(1);
            const avgWeight = (totalWeight / totalCollections).toFixed(1);
            const avgRevenue = (totalRevenue / totalCollections).toFixed(0);

            // Update display
            document.getElementById('avgDailyCollections').textContent = avgDaily;
            document.getElementById('avgWeightPerCollection').textContent = avgWeight + ' KG';
            document.getElementById('avgRevenuePerCollection').textContent = '₹' + avgRevenue;
