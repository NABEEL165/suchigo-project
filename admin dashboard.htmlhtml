<!--                <div class="nav-item">-->
<!--&lt;!&ndash;                    <a href="{% url 'super_admin_dashboard:view_collectors' %}" class="nav-link" onclick="showContent('collector-mgmt')">&ndash;&gt;-->
<!--                        <i class="fas fa-truck nav-icon"></i>-->
<!--                        <span class="nav-text">Waste Collector Management</span>-->
<!--                    </a>-->
