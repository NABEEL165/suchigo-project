<!--                <div class="nav-item">-->
<!--&lt;!&ndash;                    <a href="{% url 'super_admin_dashboard:view_customers' %}" class="nav-link" onclick="showContent('customer-mgmt')">&ndash;&gt;-->
<!--                        <i class="fas fa-users nav-icon"></i>-->
<!--                        <span class="nav-text">Customer Management</span>-->
<!--&lt;!&ndash;                    </a>&ndash;&gt;-->
