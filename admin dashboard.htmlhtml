<!--&lt;!&ndash;                    <a href="{% url 'super_admin_dashboard:users_list' %}" class="nav-link" onclick="showContent('customer-mgmt')">&ndash;&gt;-->
<!--                        <i class="fas fa-users nav-icon"></i>-->
<!--                        <span class="nav-text">Users Management</span>-->
<!--&lt;!&ndash;                    </a>&ndash;&gt;-->
